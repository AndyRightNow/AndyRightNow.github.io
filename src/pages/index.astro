---
import '../styles/global.css'

import Favicon from '../layouts/Favicon.astro'
import FontAwesome from '../layouts/FontAwesome.astro'
import GoogleFont from '../layouts/GoogleFont.astro'
import ThemeScript from '../layouts/ThemeScript.astro'
import PageMeta from '../components/PageMeta.astro'
import { SITE_TITLE } from '../config'
---

<!doctype html>
<html class="theme-bubblegum" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content="Astro" />
    <Favicon />
    <PageMeta title={SITE_TITLE} />
    <GoogleFont />
    <ThemeScript />
    <FontAwesome />
  </head>
  <body>
    <div
      class="loading-screen"
      id="loading-screen"
      aria-live="polite"
      aria-label="Loading scene"
    >
      <div class="loading-track">
        <div class="loading-progress" id="loading-progress"></div>
      </div>
    </div>
    <main class="landing-shell" aria-label="Interactive landing page">
      <canvas id="landing-canvas" aria-hidden="true"></canvas>
    </main>

    <script>
      import '../lib/home/index'
    </script>
  </body>
</html>

<style>
  :global(html) {
    background: #000000;
  }

  body {
    min-height: 100vh;
    margin: 0;
    overflow-x: hidden;
    background: #000000;
    color: #143242;
  }

  .landing-shell {
    position: relative;
    display: grid;
    min-height: 100vh;
    place-items: center;
    isolation: isolate;
    overflow: hidden;
  }

  #landing-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  .loading-screen {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: grid;
    place-items: center;
    background: #000000;
    opacity: 1;
  }

  .loading-screen.is-done {
    display: none;
  }

  .loading-track {
    width: min(18rem, 52vw);
    height: 2px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.18);
  }

  .loading-progress {
    width: 100%;
    height: 100%;
    background: #ffffff;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 180ms ease;
  }
</style>
