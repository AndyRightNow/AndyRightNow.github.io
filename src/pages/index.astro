---
import '../styles/global.css'

import Favicon from '../layouts/Favicon.astro'
import FontAwesome from '../layouts/FontAwesome.astro'
import GoogleFont from '../layouts/GoogleFont.astro'
import ThemeScript from '../layouts/ThemeScript.astro'
import PageMeta from '../components/PageMeta.astro'
import { SITE_TITLE } from '../config'
---

<!doctype html>
<html class="theme-bubblegum" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content="Astro" />
    <Favicon />
    <PageMeta title={SITE_TITLE} />
    <GoogleFont />
    <ThemeScript />
    <FontAwesome />
  </head>
  <body>
    <div class="loading-screen" id="loading-screen" aria-live="polite" aria-label="Loading scene">
      <div class="loading-track">
        <div class="loading-progress" id="loading-progress"></div>
      </div>
    </div>
    <main class="landing-shell" aria-label="Interactive landing page">
      <canvas id="landing-canvas" aria-hidden="true"></canvas>
    </main>

    <script>
      import * as THREE from 'three'
      import { RapierPhysics } from 'three/addons/physics/RapierPhysics.js'
import { FontLoader } from 'three/examples/jsm/loaders/FontLoader.js'
import { TextGeometry } from 'three/examples/jsm/geometries/TextGeometry.js'
import helvetikerBold from 'three/examples/fonts/helvetiker_bold.typeface.json'
import Stats from 'stats.js'

      const GROUND_BLUE = '#478bff'

      const sceneSettings = {
        roomColor: GROUND_BLUE,
        floorColor: GROUND_BLUE,
        textColor: '#ffffff',
        floorOpacity: 1,
        textOpacity: 1,
        floorRoughness: 0.72,
        textRoughness: 1,
        floorMetalness: 0,
        textMetalness: 0,
        floorClearcoat: 0,
        textClearcoat: 0,
        floorClearcoatRoughness: 0.5,
        textClearcoatRoughness: 0,
        floorReflectivity: 0.5,
        textReflectivity: 0,
        floorIor: 1.5,
        textIor: 1.5,
        floorTransmission: 0,
        textTransmission: 0,
        floorThickness: 0,
        textThickness: 0,
        floorSheen: 0,
        textSheen: 0,
        floorSheenRoughness: 1,
        textSheenRoughness: 1,
        floorSheenColor: '#ffffff',
        textSheenColor: '#ffffff',
        floorSpecularIntensity: 1,
        textSpecularIntensity: 0.67,
        floorSpecularColor: '#ffffff',
        textSpecularColor: '#ffffff',
        floorIridescence: 0,
        textIridescence: 0,
        floorIridescenceIOR: 1.3,
        textIridescenceIOR: 1.3,
        floorWireframe: false,
        textWireframe: false,
        floorReceivesShadow: true,
        textCastsShadow: true,
        backgroundHighlightColor: '#9cc0ff',
        backgroundShadowColor: '#276ee8',
        backgroundAccentColor: '#185ce0',
        toneMappingExposure: 1,
        cameraViewSizeDesktop: 6.2,
        cameraViewSizeMobile: 9.8,
        hemisphereSkyColor: '#8ab9ff',
        hemisphereGroundColor: GROUND_BLUE,
        hemisphereIntensity: 0.79,
        keyColor: '#ccddff',
        keyIntensity: 1.3,
        fillColor: '#6190ff',
        fillIntensity: 0.44,
        accentColor: '#ffffff',
        accentIntensity: 1.7,
        accentDistance: 16,
        spotColor: '#ffffff',
        spotIntensity: 5.7,
        spotDistance: 50,
        spotAngle: 0.65,
        spotPenumbra: 0.61,
        spotDecay: 0.86,
        textPositionX: 0,
        textPositionY: 0,
        textPositionZ: -0.55,
        textRotationX: 0,
        textRotationY: 0,
        textRotationZ: 0,
        textScale: 1,
        transformControlsEnabled: true,
        transformControlsMode: 'translate',
        transformControlsSize: 0.75,
        transformControlsSpace: 'world',
        transformControlsShowX: true,
        transformControlsShowY: true,
        transformControlsShowZ: true,
        scrollForwardOffset: 0,
         scrollForwardMin: 0,
        scrollForwardMax: 5,
        clickImpulseStrength: 1.45,
      }
      const initialSceneSettings = structuredClone(sceneSettings)

      const canvas = document.querySelector('#landing-canvas')

      if (!(canvas instanceof HTMLCanvasElement)) {
        throw new Error('Landing canvas was not found.')
      }

      const roomColor = new THREE.Color(sceneSettings.roomColor)
      const floorColor = new THREE.Color(sceneSettings.floorColor)
      const white = new THREE.Color(sceneSettings.textColor)
      const loadingScreen = document.querySelector('#loading-screen')
      const loadingProgress = document.querySelector('#loading-progress')

      if (!(loadingScreen instanceof HTMLDivElement)) {
        throw new Error('Loading screen was not found.')
      }

      if (!(loadingProgress instanceof HTMLDivElement)) {
        throw new Error('Loading progress bar was not found.')
      }

      const loadingManager = new THREE.LoadingManager()
      let sceneReady = false
      let startupStartedAt = null
      const INITIAL_ROOM_LIGHT_SCALE = 0.035
      const DIM_ROOM_HOLD_SECONDS = 1
      let roomLightScale = INITIAL_ROOM_LIGHT_SCALE
      let spotLightScale = 0

      const scene = new THREE.Scene()
      scene.background = roomColor
      scene.fog = new THREE.Fog(roomColor, 18, 42)

      const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 100)
      camera.position.set(8.5, 8.5, 8.5)
      camera.lookAt(0, 0.65, 0)

      const renderer = new THREE.WebGLRenderer({
        antialias: true,
        canvas,
        powerPreference: 'high-performance',
      })
      renderer.setClearColor(roomColor, 1)
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5))
      renderer.shadowMap.enabled = true
      renderer.shadowMap.type = THREE.PCFSoftShadowMap
      renderer.toneMapping = THREE.ACESFilmicToneMapping
      renderer.toneMappingExposure = sceneSettings.toneMappingExposure

      const stage = new THREE.Group()
      scene.add(stage)

      const floorMaterial = new THREE.MeshStandardMaterial({
        color: floorColor,
        roughness: sceneSettings.floorRoughness,
        metalness: sceneSettings.floorMetalness,
      })

      const floor = new THREE.Mesh(new THREE.BoxGeometry(72, 2, 72), floorMaterial)
      floor.position.y = -1
      floor.receiveShadow = true
      stage.add(floor)

      const nameGroup = new THREE.Group()
      nameGroup.position.set(
        sceneSettings.textPositionX,
        sceneSettings.textPositionY,
        sceneSettings.textPositionZ,
      )
      scene.add(nameGroup)

      const nameMaterial = new THREE.MeshStandardMaterial({
        color: white,
        roughness: sceneSettings.textRoughness,
        metalness: sceneSettings.textMetalness,
      })

      let nameMesh = null
      let transformControls = null
      const transformGuiControllers = []

      const hemisphereLight = new THREE.HemisphereLight(
        sceneSettings.hemisphereSkyColor,
        sceneSettings.hemisphereGroundColor,
        sceneSettings.hemisphereIntensity,
      )
      scene.add(hemisphereLight)

      const keyLight = new THREE.DirectionalLight(sceneSettings.keyColor, sceneSettings.keyIntensity)
      keyLight.position.set(-5, 9, 6)
      keyLight.castShadow = true
      keyLight.shadow.mapSize.width = 1024
      keyLight.shadow.mapSize.height = 1024
      keyLight.shadow.camera.left = -9
      keyLight.shadow.camera.right = 9
      keyLight.shadow.camera.top = 9
      keyLight.shadow.camera.bottom = -9
      keyLight.shadow.camera.near = 1
      keyLight.shadow.camera.far = 24
      keyLight.shadow.bias = -0.00012
      keyLight.shadow.normalBias = 0.002
      scene.add(keyLight)

      const fillLight = new THREE.DirectionalLight(sceneSettings.fillColor, sceneSettings.fillIntensity)
      fillLight.position.set(7, 5, -4)
      scene.add(fillLight)

      const accentLight = new THREE.PointLight(
        sceneSettings.accentColor,
        sceneSettings.accentIntensity,
        sceneSettings.accentDistance,
      )
      accentLight.position.set(2.5, 4.6, 2.5)
      scene.add(accentLight)

      const overheadSpotTarget = new THREE.Object3D()
      overheadSpotTarget.position.set(0, 0, -0.35)
      scene.add(overheadSpotTarget)

      const overheadSpotLight = new THREE.SpotLight(
        sceneSettings.spotColor,
        sceneSettings.spotIntensity,
        sceneSettings.spotDistance,
        sceneSettings.spotAngle,
        sceneSettings.spotPenumbra,
        sceneSettings.spotDecay,
      )
      overheadSpotLight.position.set(0, 9, -0.35)
      overheadSpotLight.target = overheadSpotTarget
      overheadSpotLight.castShadow = true
      overheadSpotLight.shadow.mapSize.width = 512
      overheadSpotLight.shadow.mapSize.height = 512
      overheadSpotLight.shadow.bias = -0.00012
      overheadSpotLight.shadow.normalBias = 0.002
      scene.add(overheadSpotLight)

      let viewSize = sceneSettings.cameraViewSizeDesktop
      const cameraBasePosition = new THREE.Vector3(8.5, 8.5, 8.5)
      const cameraBaseLookAt = new THREE.Vector3(0, 0.65, 0)
      const cameraCurrentLookAt = cameraBaseLookAt.clone()
      const spotlightBasePosition = new THREE.Vector3(0, 9, -0.35)
      const spotlightTargetBasePosition = new THREE.Vector3(0, 0, -0.35)
      const textForward = new THREE.Vector3(0, 0, 1)
      const raycaster = new THREE.Raycaster()
      const pointer = new THREE.Vector2()
      const physicsMeshes = []
      const customPhysicsMap = new Map()
      let physics = null
      let lastPhysicsStepAt = performance.now()

      const updateBackground = () => {
        document.documentElement.style.background = '#000000'
        document.body.style.background = '#000000'
      }

      const updateSceneColors = () => {
        roomColor.set(sceneSettings.roomColor)
        floorMaterial.color.set(sceneSettings.floorColor)
        nameMaterial.color.set(sceneSettings.textColor)
        scene.background = roomColor
        scene.fog?.color.set(roomColor)
        renderer.setClearColor(roomColor, 1)
        updateBackground()
      }

      const updateMaterials = () => {
        floorMaterial.color.set(sceneSettings.floorColor)
        floorMaterial.roughness = sceneSettings.floorRoughness
        floorMaterial.metalness = sceneSettings.floorMetalness
        floorMaterial.needsUpdate = true
        floor.receiveShadow = sceneSettings.floorReceivesShadow

        nameMaterial.color.set(sceneSettings.textColor)
        nameMaterial.roughness = sceneSettings.textRoughness
        nameMaterial.metalness = sceneSettings.textMetalness
        nameMaterial.needsUpdate = true

        if (nameMesh) {
          nameMesh.traverse((object) => {
            if (object instanceof THREE.Mesh) {
              object.castShadow = sceneSettings.textCastsShadow
            }
          })
        }
      }

      const updateLighting = () => {
        hemisphereLight.color.set(sceneSettings.hemisphereSkyColor)
        hemisphereLight.groundColor.set(sceneSettings.hemisphereGroundColor)
        hemisphereLight.intensity = sceneSettings.hemisphereIntensity * roomLightScale
        keyLight.color.set(sceneSettings.keyColor)
        keyLight.intensity = sceneSettings.keyIntensity * roomLightScale
        fillLight.color.set(sceneSettings.fillColor)
        fillLight.intensity = sceneSettings.fillIntensity * roomLightScale
        accentLight.color.set(sceneSettings.accentColor)
        accentLight.intensity = sceneSettings.accentIntensity * roomLightScale
        accentLight.distance = sceneSettings.accentDistance
        overheadSpotLight.color.set(sceneSettings.spotColor)
        overheadSpotLight.intensity = sceneSettings.spotIntensity * spotLightScale
        overheadSpotLight.distance = sceneSettings.spotDistance
        overheadSpotLight.angle = sceneSettings.spotAngle
        overheadSpotLight.penumbra = sceneSettings.spotPenumbra
        overheadSpotLight.decay = sceneSettings.spotDecay
        renderer.toneMappingExposure = sceneSettings.toneMappingExposure
      }

      const updateScrollMotion = () => {
        const offset = textForward.clone().multiplyScalar(sceneSettings.scrollForwardOffset)

        camera.position.copy(cameraBasePosition).add(offset)
        cameraCurrentLookAt.copy(cameraBaseLookAt).add(offset)
        overheadSpotLight.position.copy(spotlightBasePosition).add(offset)
        overheadSpotTarget.position.copy(spotlightTargetBasePosition).add(offset)
      }

      const resetPhysicsBodyFromMesh = (mesh) => {
        const body = mesh.userData.physics?.body

        if (!body) {
          return
        }

        const entry = customPhysicsMap.get(mesh)
        const centerOffset = entry?.centerOffset

        const worldPos = new THREE.Vector3()
        mesh.getWorldPosition(worldPos)

        if (centerOffset) {
          worldPos.add(centerOffset)
        }

        body.setTranslation({ x: worldPos.x, y: worldPos.y, z: worldPos.z }, true)
        body.setRotation({ x: 0, y: 0, z: 0, w: 1 }, true)
        body.setLinvel({ x: 0, y: 0, z: 0 }, true)
        body.setAngvel({ x: 0, y: 0, z: 0 }, true)
      }

      const syncPhysicsFromTransform = () => {
        for (const mesh of physicsMeshes) {
          resetPhysicsBodyFromMesh(mesh)
        }
      }

      const syncTransformSettingsFromObject = () => {
        sceneSettings.textPositionX = Number(nameGroup.position.x.toFixed(4))
        sceneSettings.textPositionY = Number(nameGroup.position.y.toFixed(4))
        sceneSettings.textPositionZ = Number(nameGroup.position.z.toFixed(4))
        sceneSettings.textRotationX = Number(nameGroup.rotation.x.toFixed(4))
        sceneSettings.textRotationY = Number(nameGroup.rotation.y.toFixed(4))
        sceneSettings.textRotationZ = Number(nameGroup.rotation.z.toFixed(4))
        sceneSettings.textScale = Number(nameGroup.scale.x.toFixed(4))
        transformGuiControllers.forEach((controller) => controller.updateDisplay())
      }

      const updateTextTransform = () => {
        nameGroup.position.set(
          sceneSettings.textPositionX,
          sceneSettings.textPositionY,
          sceneSettings.textPositionZ,
        )
        nameGroup.rotation.set(
          sceneSettings.textRotationX,
          sceneSettings.textRotationY,
          sceneSettings.textRotationZ,
        )
        nameGroup.scale.setScalar(sceneSettings.textScale)
        syncPhysicsFromTransform()
      }

      const updateTransformControls = () => {
        if (!transformControls) {
          return
        }

        transformControls.enabled = sceneSettings.transformControlsEnabled
        transformControls.visible = sceneSettings.transformControlsEnabled
        transformControls.mode = sceneSettings.transformControlsMode
        transformControls.size = sceneSettings.transformControlsSize
        transformControls.space = sceneSettings.transformControlsSpace
        transformControls.showX = sceneSettings.transformControlsShowX
        transformControls.showY = sceneSettings.transformControlsShowY
        transformControls.showZ = sceneSettings.transformControlsShowZ
      }

      const copySceneSettings = async () => {
        const changedSettings = Object.fromEntries(
          Object.entries(sceneSettings)
            .filter(([key, value]) => initialSceneSettings[key] !== value)
            .map(([key, value]) => [
              key,
              typeof value === 'number' ? Number(value.toFixed(4)) : value,
            ]),
        )

        await navigator.clipboard.writeText(
          JSON.stringify(changedSettings, null, 2),
        )
      }

      const resize = () => {
        const { innerWidth, innerHeight } = window
        const aspect = innerWidth / innerHeight
        viewSize =
          innerWidth < 720 ? sceneSettings.cameraViewSizeMobile : sceneSettings.cameraViewSizeDesktop

        camera.left = (-viewSize * aspect) / 2
        camera.right = (viewSize * aspect) / 2
        camera.top = viewSize / 2
        camera.bottom = -viewSize / 2
        camera.updateProjectionMatrix()
        renderer.setSize(innerWidth, innerHeight, false)
        requestRender()
      }

      const handleWheel = (event) => {
        event.preventDefault()
        const nextOffset = sceneSettings.scrollForwardOffset + event.deltaY * 0.003
        sceneSettings.scrollForwardOffset = Math.min(
          Math.max(nextOffset, sceneSettings.scrollForwardMin),
          sceneSettings.scrollForwardMax,
        )
        updateScrollMotion()
        requestRender()
      }

      const handlePointerDown = (event) => {
        if (transformControls?.dragging || physicsMeshes.length === 0) {
          return
        }

        pointer.x = (event.clientX / window.innerWidth) * 2 - 1
        pointer.y = -(event.clientY / window.innerHeight) * 2 + 1
        raycaster.setFromCamera(pointer, camera)

        const hits = raycaster.intersectObjects(physicsMeshes, true)
        const hit = hits.find((entry) => physicsMeshes.includes(entry.object))

        if (!hit) {
          return
        }

        const body = hit.object.userData.physics?.body

        if (!body || typeof body.applyImpulseAtPoint !== 'function') {
          throw new Error('Rapier body does not support applyImpulseAtPoint.')
        }

        const randomDirection = new THREE.Vector3(
          Math.random() - 0.5,
          Math.random() * 0.65 + 0.35,
          Math.random() - 0.5,
        ).normalize()
        const impulseVector = randomDirection.multiplyScalar(sceneSettings.clickImpulseStrength)
        const impulse = { x: impulseVector.x, y: impulseVector.y, z: impulseVector.z }
        const point = { x: hit.point.x, y: hit.point.y, z: hit.point.z }

        body.applyImpulseAtPoint(impulse, point, true)
        requestRender()
      }

      const setupLocalControls = async () => {
        const { default: GUI } = await import('lil-gui')
        const { TransformControls } = await import('three/examples/jsm/controls/TransformControls.js')

        statsPanel = new Stats()
        statsPanel.showPanel(0)
        document.body.appendChild(statsPanel.dom)

        transformControls = new TransformControls(camera, renderer.domElement)
        transformControls.attach(nameGroup)
        scene.add(transformControls.getHelper())
        transformControls.addEventListener('objectChange', syncTransformSettingsFromObject)
        updateTransformControls()

        const gui = new GUI({ title: 'Scene controls' })
        const sceneFolder = gui.addFolder('Scene')
        sceneFolder.addColor(sceneSettings, 'roomColor').name('Room').onChange(updateSceneColors)
        sceneFolder
          .add(sceneSettings, 'toneMappingExposure', 0.1, 2.5, 0.01)
          .name('Exposure')
          .onChange(updateLighting)

        const materialsFolder = gui.addFolder('Materials')
        const addPhysicalMaterialControls = (folder, label, prefix, updateColor) => {
          const materialFolder = folder.addFolder(label)

          materialFolder
            .addColor(sceneSettings, `${prefix}Color`)
            .name('Color')
            .onChange(updateColor)
          materialFolder
            .add(sceneSettings, `${prefix}Opacity`, 0, 1, 0.01)
            .name('Opacity')
            .onChange(updateMaterials)
          materialFolder
            .add(sceneSettings, `${prefix}Roughness`, 0, 1, 0.01)
            .name('Roughness')
            .onChange(updateMaterials)
          materialFolder
            .add(sceneSettings, `${prefix}Metalness`, 0, 1, 0.01)
            .name('Metalness')
            .onChange(updateMaterials)
          materialFolder
            .add(sceneSettings, `${prefix}Clearcoat`, 0, 1, 0.01)
            .name('Clearcoat')
            .onChange(updateMaterials)
          materialFolder
            .add(sceneSettings, `${prefix}ClearcoatRoughness`, 0, 1, 0.01)
            .name('Clearcoat roughness')
            .onChange(updateMaterials)
          materialFolder
            .add(sceneSettings, `${prefix}Reflectivity`, 0, 1, 0.01)
            .name('Reflectivity')
            .onChange(updateMaterials)
          materialFolder
            .add(sceneSettings, `${prefix}Ior`, 1, 2.333, 0.001)
            .name('IOR')
            .onChange(updateMaterials)
          materialFolder
            .add(sceneSettings, `${prefix}Transmission`, 0, 1, 0.01)
            .name('Transmission')
            .onChange(updateMaterials)
          materialFolder
            .add(sceneSettings, `${prefix}Thickness`, 0, 5, 0.01)
            .name('Thickness')
            .onChange(updateMaterials)
          materialFolder
            .add(sceneSettings, `${prefix}Sheen`, 0, 1, 0.01)
            .name('Sheen')
            .onChange(updateMaterials)
          materialFolder
            .add(sceneSettings, `${prefix}SheenRoughness`, 0, 1, 0.01)
            .name('Sheen roughness')
            .onChange(updateMaterials)
          materialFolder
            .addColor(sceneSettings, `${prefix}SheenColor`)
            .name('Sheen color')
            .onChange(updateMaterials)
          materialFolder
            .add(sceneSettings, `${prefix}SpecularIntensity`, 0, 2, 0.01)
            .name('Specular intensity')
            .onChange(updateMaterials)
          materialFolder
            .addColor(sceneSettings, `${prefix}SpecularColor`)
            .name('Specular color')
            .onChange(updateMaterials)
          materialFolder
            .add(sceneSettings, `${prefix}Iridescence`, 0, 1, 0.01)
            .name('Iridescence')
            .onChange(updateMaterials)
          materialFolder
            .add(sceneSettings, `${prefix}IridescenceIOR`, 1, 2.333, 0.001)
            .name('Iridescence IOR')
            .onChange(updateMaterials)
          materialFolder
            .add(sceneSettings, `${prefix}Wireframe`)
            .name('Wireframe')
            .onChange(updateMaterials)
        }

        addPhysicalMaterialControls(materialsFolder, 'Floor', 'floor', updateSceneColors)
        materialsFolder
          .add(sceneSettings, 'floorReceivesShadow')
          .name('Floor receives shadow')
          .onChange(updateMaterials)
        addPhysicalMaterialControls(materialsFolder, 'Text', 'text', updateSceneColors)
        materialsFolder
          .add(sceneSettings, 'textCastsShadow')
          .name('Text casts shadow')
          .onChange(updateMaterials)

        const backgroundFolder = gui.addFolder('CSS background')
        backgroundFolder
          .addColor(sceneSettings, 'backgroundHighlightColor')
          .name('Highlight')
          .onChange(updateBackground)
        backgroundFolder
          .addColor(sceneSettings, 'backgroundAccentColor')
          .name('Accent')
          .onChange(updateBackground)
        backgroundFolder
          .addColor(sceneSettings, 'backgroundShadowColor')
          .name('Shadow')
          .onChange(updateBackground)

        const cameraFolder = gui.addFolder('Camera')
        cameraFolder
          .add(sceneSettings, 'cameraViewSizeDesktop', 5, 16, 0.1)
          .name('Desktop size')
          .onChange(resize)
        cameraFolder
          .add(sceneSettings, 'cameraViewSizeMobile', 5, 18, 0.1)
          .name('Mobile size')
          .onChange(resize)
        cameraFolder
          .add(sceneSettings, 'scrollForwardOffset', sceneSettings.scrollForwardMin, sceneSettings.scrollForwardMax, 0.01)
          .name('Scroll offset')
          .onChange(updateScrollMotion)

        const physicsFolder = gui.addFolder('Physics')
        physicsFolder
          .add(sceneSettings, 'clickImpulseStrength', 0, 8, 0.05)
          .name('Click impulse')

        const transformFolder = gui.addFolder('Text transform')
        transformFolder
          .add(sceneSettings, 'transformControlsEnabled')
          .name('Enabled')
          .onChange(updateTransformControls)
        transformFolder
          .add(sceneSettings, 'transformControlsMode', ['translate', 'rotate', 'scale'])
          .name('Mode')
          .onChange(updateTransformControls)
        transformFolder
          .add(sceneSettings, 'transformControlsSpace', ['world', 'local'])
          .name('Space')
          .onChange(updateTransformControls)
        transformFolder
          .add(sceneSettings, 'transformControlsSize', 0.25, 2, 0.01)
          .name('Gizmo size')
          .onChange(updateTransformControls)
        transformFolder
          .add(sceneSettings, 'transformControlsShowX')
          .name('Show X')
          .onChange(updateTransformControls)
        transformFolder
          .add(sceneSettings, 'transformControlsShowY')
          .name('Show Y')
          .onChange(updateTransformControls)
        transformFolder
          .add(sceneSettings, 'transformControlsShowZ')
          .name('Show Z')
          .onChange(updateTransformControls)
        transformGuiControllers.push(
          transformFolder
          .add(sceneSettings, 'textPositionX', -8, 8, 0.01)
          .name('Position X')
          .onChange(updateTextTransform),
        )
        transformGuiControllers.push(
          transformFolder
          .add(sceneSettings, 'textPositionY', -2, 4, 0.01)
          .name('Position Y')
          .onChange(updateTextTransform),
        )
        transformGuiControllers.push(
          transformFolder
          .add(sceneSettings, 'textPositionZ', -8, 8, 0.01)
          .name('Position Z')
          .onChange(updateTextTransform),
        )
        transformGuiControllers.push(
          transformFolder
          .add(sceneSettings, 'textRotationX', -Math.PI, Math.PI, 0.01)
          .name('Rotation X')
          .onChange(updateTextTransform),
        )
        transformGuiControllers.push(
          transformFolder
          .add(sceneSettings, 'textRotationY', -Math.PI, Math.PI, 0.01)
          .name('Rotation Y')
          .onChange(updateTextTransform),
        )
        transformGuiControllers.push(
          transformFolder
          .add(sceneSettings, 'textRotationZ', -Math.PI, Math.PI, 0.01)
          .name('Rotation Z')
          .onChange(updateTextTransform),
        )
        transformGuiControllers.push(
          transformFolder
          .add(sceneSettings, 'textScale', 0.2, 3, 0.01)
          .name('Scale')
          .onChange(updateTextTransform),
        )

        const ambientFolder = gui.addFolder('Ambient')
        ambientFolder
          .addColor(sceneSettings, 'hemisphereSkyColor')
          .name('Sky')
          .onChange(updateLighting)
        ambientFolder
          .addColor(sceneSettings, 'hemisphereGroundColor')
          .name('Ground')
          .onChange(updateLighting)
        ambientFolder
          .add(sceneSettings, 'hemisphereIntensity', 0, 4, 0.01)
          .name('Intensity')
          .onChange(updateLighting)

        const keyFolder = gui.addFolder('Key')
        keyFolder.addColor(sceneSettings, 'keyColor').name('Color').onChange(updateLighting)
        keyFolder.add(sceneSettings, 'keyIntensity', 0, 4, 0.01).name('Intensity').onChange(updateLighting)

        const fillFolder = gui.addFolder('Fill')
        fillFolder.addColor(sceneSettings, 'fillColor').name('Color').onChange(updateLighting)
        fillFolder
          .add(sceneSettings, 'fillIntensity', 0, 4, 0.01)
          .name('Intensity')
          .onChange(updateLighting)

        const spotFolder = gui.addFolder('Spot')
        spotFolder.addColor(sceneSettings, 'spotColor').name('Color').onChange(updateLighting)
        spotFolder
          .add(sceneSettings, 'spotIntensity', 0, 24, 0.1)
          .name('Intensity')
          .onChange(updateLighting)
        spotFolder.add(sceneSettings, 'spotDistance', 1, 60, 0.5).name('Distance').onChange(updateLighting)
        spotFolder.add(sceneSettings, 'spotAngle', 0.05, Math.PI / 2, 0.01).name('Angle').onChange(updateLighting)
        spotFolder
          .add(sceneSettings, 'spotPenumbra', 0, 1, 0.01)
          .name('Penumbra')
          .onChange(updateLighting)
        spotFolder.add(sceneSettings, 'spotDecay', 0, 3, 0.01).name('Decay').onChange(updateLighting)

        const accentFolder = gui.addFolder('Accent')
        accentFolder.addColor(sceneSettings, 'accentColor').name('Color').onChange(updateLighting)
        accentFolder
          .add(sceneSettings, 'accentIntensity', 0, 20, 0.1)
          .name('Intensity')
          .onChange(updateLighting)
        accentFolder
          .add(sceneSettings, 'accentDistance', 1, 60, 0.5)
          .name('Distance')
          .onChange(updateLighting)

        gui.add({ copy: copySceneSettings }, 'copy').name('Copy values')
      }

      updateSceneColors()
      updateLighting()
      updateMaterials()
      updateTextTransform()

      if (import.meta.env.DEV) {
        setupLocalControls()
      }

      const addCustomPhysicsBody = (mesh, mass, restitution) => {
        mesh.geometry.computeBoundingBox()
        const bbox = mesh.geometry.boundingBox
        const cx = (bbox.min.x + bbox.max.x) / 2
        const cy = (bbox.min.y + bbox.max.y) / 2
        const cz = (bbox.min.z + bbox.max.z) / 2
        const sx = Math.max((bbox.max.x - bbox.min.x) / 2 - 0.03, 0.03)
        const sy = Math.max((bbox.max.y - bbox.min.y) / 2, 0.03)
        const sz = Math.max((bbox.max.z - bbox.min.z) / 2 - 0.02, 0.03)

        const shape = physics.RAPIER.ColliderDesc.cuboid(sx, sy, sz)
        shape.setMass(mass)
        shape.setRestitution(restitution)

        const localCenter = new THREE.Vector3(cx, cy, cz)
        const worldCenter = localCenter.clone()
        mesh.localToWorld(worldCenter)

        const bodyDesc = physics.RAPIER.RigidBodyDesc.dynamic()
        bodyDesc.setTranslation(worldCenter.x, worldCenter.y, worldCenter.z)
        bodyDesc.setLinearDamping(0.35)
        bodyDesc.lockRotations()
        const body = physics.world.createRigidBody(bodyDesc)
        physics.world.createCollider(shape, body)

        mesh.userData.physics = { mass, restitution, body }
        customPhysicsMap.set(mesh, { body, centerOffset: localCenter })
      }

      const syncCustomPhysicsBodies = () => {
        if (customPhysicsMap.size === 0) return false

        const worldPos = new THREE.Vector3()
        let anyMoving = false
        const velocityThreshold = 0.001

        for (const [mesh, { body, centerOffset }] of customPhysicsMap) {
          const linvel = body.linvel()
          const angvel = body.angvel()
          if (
            Math.abs(linvel.x) > velocityThreshold ||
            Math.abs(linvel.y) > velocityThreshold ||
            Math.abs(linvel.z) > velocityThreshold ||
            Math.abs(angvel.x) > velocityThreshold ||
            Math.abs(angvel.y) > velocityThreshold ||
            Math.abs(angvel.z) > velocityThreshold
          ) {
            anyMoving = true
          }

          const t = body.translation()
          worldPos.set(t.x - centerOffset.x, t.y - centerOffset.y, t.z - centerOffset.z)

          if (mesh.parent) {
            mesh.parent.worldToLocal(worldPos)
          }

          mesh.position.copy(worldPos)
          mesh.quaternion.set(0, 0, 0, 1)
        }

        return anyMoving
      }

      const setupPhysics = async () => {
        loadingManager.itemStart('rapier-physics')
        physics = await RapierPhysics()

        const floorShape = physics.RAPIER.ColliderDesc.cuboid(36, 1, 36)
        const floorBodyDesc = physics.RAPIER.RigidBodyDesc.fixed()
        floorBodyDesc.setTranslation(0, -1, 0)
        const floorBody = physics.world.createRigidBody(floorBodyDesc)
        physics.world.createCollider(floorShape, floorBody)

        for (const mesh of physicsMeshes) {
          addCustomPhysicsBody(mesh, 0.8, 0.22)
        }

        loadingManager.itemEnd('rapier-physics')
      }

      const easeOutCubic = (value) => 1 - Math.pow(1 - value, 3)
      const clamp01 = (value) => Math.min(Math.max(value, 0), 1)

      const loadNameText = () => {
        loadingManager.itemStart('name-text')

        window.requestAnimationFrame(() => {
          const font = new FontLoader(loadingManager).parse(helvetikerBold)
          const glyphMeshes = []
          let cursorX = 0

          for (const glyph of 'ANDY ZHOU') {
            if (glyph === ' ') {
              cursorX += 0.52
              continue
            }

            const textGeometry = new TextGeometry(glyph, {
              font,
              size: 1.02,
              depth: 0.24,
              curveSegments: 32,
              bevelEnabled: true,
              bevelThickness: 0.018,
              bevelSize: 0.012,
              bevelSegments: 8,
            })
            textGeometry.computeVertexNormals()
            textGeometry.computeBoundingBox()

            if (!textGeometry.boundingBox) {
              throw new Error(`Glyph geometry bounds were not calculated: ${glyph}`)
            }

            const bounds = textGeometry.boundingBox
            textGeometry.translate(-bounds.min.x, -bounds.min.y, -(bounds.min.z + bounds.max.z) / 2)
            textGeometry.computeBoundingBox()

            if (!textGeometry.boundingBox) {
              throw new Error(`Glyph geometry bounds were not recalculated: ${glyph}`)
            }

            const glyphMesh = new THREE.Mesh(textGeometry, nameMaterial)
            glyphMesh.castShadow = sceneSettings.textCastsShadow
            glyphMesh.receiveShadow = false
            glyphMesh.position.set(cursorX, -textGeometry.boundingBox.min.y, 0)
            glyphMesh.userData.physics = { mass: 0.8, restitution: 0.22 }
            nameGroup.add(glyphMesh)
            glyphMeshes.push(glyphMesh)
            physicsMeshes.push(glyphMesh)

            cursorX += textGeometry.boundingBox.max.x + 0.08
          }

          const nameBounds = new THREE.Box3().setFromObject(nameGroup)
          const centerX = (nameBounds.min.x + nameBounds.max.x) / 2

          for (const glyphMesh of glyphMeshes) {
            glyphMesh.position.x -= centerX
          }

          if (physics) {
            for (const glyphMesh of glyphMeshes) {
              addCustomPhysicsBody(glyphMesh, 0.8, 0.22)
            }
          }

          nameMesh = nameGroup
          loadingManager.itemEnd('name-text')
        })
      }

      loadingManager.onProgress = (_url, loaded, total) => {
        const progress = total > 0 ? loaded / total : 1
        loadingProgress.style.transform = `scaleX(${progress})`
      }

      loadingManager.onLoad = () => {
        loadingProgress.style.transform = 'scaleX(1)'
        sceneReady = true
        startupStartedAt = performance.now()
        window.setTimeout(() => {
          loadingScreen.classList.add('is-done')
        }, 220)
      }

      loadingManager.onError = (url) => {
        throw new Error(`Failed to load scene asset: ${url}`)
      }

      loadNameText()
      setupPhysics()

      let renderLoopId = null
      let needsRender = true
      let startupAnimationDone = false
      let statsPanel = null
      const requestRender = () => {
        needsRender = true
        if (renderLoopId === null) {
          renderLoopId = window.requestAnimationFrame(animate)
        }
      }

      const updateStartupAnimation = (elapsedMs) => {
        if (!sceneReady || startupStartedAt === null) {
          roomLightScale = INITIAL_ROOM_LIGHT_SCALE
          spotLightScale = 0
          updateLighting()
          return
        }

        const startupElapsed = (elapsedMs - startupStartedAt) / 1000
        const sequenceElapsed = Math.max(startupElapsed - DIM_ROOM_HOLD_SECONDS, 0)
        roomLightScale =
          INITIAL_ROOM_LIGHT_SCALE +
          easeOutCubic(clamp01(sequenceElapsed / 0.75)) * (1 - INITIAL_ROOM_LIGHT_SCALE)

        if (sequenceElapsed < 1.05) {
          spotLightScale = 0
        } else if (sequenceElapsed < 2.05) {
          const flickerElapsed = sequenceElapsed - 1.05
          const flickerPulses = [
            [0.0, 0.16, 0.18],
            [0.28, 0.15, 0.62],
            [0.58, 0.2, 0.34],
            [0.86, 0.14, 0.78],
          ]
          spotLightScale = 0.08

          for (const [start, duration, intensity] of flickerPulses) {
            const progress = clamp01((flickerElapsed - start) / duration)

            if (progress > 0 && progress < 1) {
              spotLightScale = intensity * Math.sin(progress * Math.PI)
            }
          }
        } else {
          spotLightScale = 0.25 + easeOutCubic(clamp01((sequenceElapsed - 2.05) / 0.7)) * 0.75
        }

        if (!startupAnimationDone && sequenceElapsed >= 2.75) {
          startupAnimationDone = true
        }

        updateLighting()
      }

      const animate = () => {
        const now = performance.now()

        if (!startupAnimationDone) {
          updateStartupAnimation(now)
          needsRender = true
        }

        camera.lookAt(cameraCurrentLookAt)

        if (physics) {
          try {
            const bodiesInMotion = syncCustomPhysicsBodies()
            if (bodiesInMotion) {
              needsRender = true
            }
          } catch (_) {
            // physics sync is best-effort; skip if bodies aren't ready
          }
        }

        if (needsRender) {
          if (statsPanel) statsPanel.begin()
          renderer.render(scene, camera)
          if (statsPanel) statsPanel.end()
        }

        const keepLooping = needsRender || !startupAnimationDone

        if (keepLooping) {
          needsRender = false
          renderLoopId = window.requestAnimationFrame(animate)
        } else {
          renderLoopId = null
        }
      }

      resize()
      requestRender()

      window.addEventListener('resize', resize)
      window.addEventListener('wheel', handleWheel, { passive: false })
      window.addEventListener('pointerdown', handlePointerDown)
    </script>
  </body>
</html>

<style>
  :global(html) {
    background: #000000;
  }

  body {
    min-height: 100vh;
    margin: 0;
    overflow-x: hidden;
    background: #000000;
    color: #143242;
  }

  .landing-shell {
    position: relative;
    display: grid;
    min-height: 100vh;
    place-items: center;
    isolation: isolate;
    overflow: hidden;
  }

  #landing-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  .loading-screen {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: grid;
    place-items: center;
    background: #000000;
    opacity: 1;
  }

  .loading-screen.is-done {
    display: none;
  }

  .loading-track {
    width: min(18rem, 52vw);
    height: 2px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.18);
  }

  .loading-progress {
    width: 100%;
    height: 100%;
    background: #ffffff;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 180ms ease;
  }
</style>
